# Application & Environment
APP_ENV=development
APP_NAME="The AI Economy"
DEBUG=True
PORT=8000
SECRET_KEY=change_this_to_a_super_secret_key_at_least_32_chars_long
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_password
POSTGRES_DB=ai_economy_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres_dev_password@db:5432/ai_economy_db

# OpenAI API (LLM Orchestration)
OPENAI_API_KEY=mock-or-actual-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# PayPal Sandbox Credentials (Orders API v2)
PAYPAL_MODE=sandbox
PAYPAL_MOCK_MODE=false
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Frontend & CORS
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Internal Accounting & Fee Configuration
PLATFORM_FEE_PERCENTAGE=0.05
DEFAULT_CURRENCY=USD
